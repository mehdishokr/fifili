{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fifili",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "afd59a84-085e-4256-bc4e-463a4b3eb370","database_name": "fifili-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7bcdc6179dc6422e82ce1f0b6f1862b9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
